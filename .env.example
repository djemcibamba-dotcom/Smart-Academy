# Copier vers .env et modifier les secrets en production
NODE_ENV=development
PORT=3000

# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGEZ_MOI_access_secret_64_caracteres_minimum_recommande
JWT_REFRESH_SECRET=CHANGEZ_MOI_refresh_secret_different_du_access

DATABASE_PATH=./data/sac.db
UPLOAD_DIR=./uploads

# Origines autorisées (séparées par virgule)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookies HTTPS uniquement en production
COOKIE_SECURE=false

# Limite tentatives connexion
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
